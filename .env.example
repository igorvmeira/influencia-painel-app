# ===== FIREBASE ADMIN (servidor) — escolha UMA das duas opções =====

# OPÇÃO A (recomendada, à prova de erro de chave):
# Pegue o JSON da conta de serviço (Firebase > Configurações > Contas de serviço >
# Gerar nova chave privada) e converta o arquivo inteiro para base64.
# Cole o resultado numa linha só aqui:
FIREBASE_SERVICE_ACCOUNT_BASE64=

# OPÇÃO B (três variáveis separadas):
# FIREBASE_PROJECT_ID=seu-projeto
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
# IMPORTANTE: no .env.local, a chave PRECISA estar entre aspas e com \n literais.
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ===== FIREBASE WEB (cliente) — OBRIGATÓRIAS =====
# Config pública do Firebase (Configurações do projeto > Seus apps > App da Web).
# NÃO são segredo (vão para o navegador), mas SEM elas o login não funciona —
# e todas as telas são protegidas por login.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== META MARKETING API (servidor, SEGREDO) =====
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# ===== SEGURANÇA DAS ROTAS INTERNAS (servidor, SEGREDO) — OBRIGATÓRIA =====
# String aleatória e forte. Protege /api/sync-meta, /api/import-contas,
# /api/import-orientacoes e /api/diagnostico-contas (via "Authorization: Bearer
# <CRON_SECRET>" ou ?key=<CRON_SECRET>).
# ⚠️ EM AUTOMAÇÃO, USE SEMPRE O CABEÇALHO. Query string é registrada em log por todo
# mundo no caminho — o Next imprime a URL inteira no console do servidor, e proxy,
# CDN e histórico de navegador fazem o mesmo. O `?key=` existe só para chamada
# manual no navegador, onde não dá para mandar cabeçalho.
# ATENÇÃO: a verificação FALHA FECHADO — sem esta variável, essas rotas respondem
# 500 e não executam nada (antes ficavam abertas). O cron do GitHub Actions manda
# esta mesma chave.
CRON_SECRET=

# ===== GOOGLE AGENDA (servidor, SEGREDO) — necessário para a tela /reunioes =====
# ID do calendário da agência (Agenda > Configurações do calendário > ID).
# O calendário precisa estar COMPARTILHADO com o e-mail da conta de serviço abaixo.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Mesma regra da chave do Firebase: entre aspas e com \n literais.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ===== XMAX (CRM do comercial) — futuro painel comercial =====
# Instância white-label do AtenderBem. Spec em data/xmax-api.yaml; levantamento e
# riscos em data/xmax-integracao.md.
# ATENÇÃO: as duas chaves dão acesso de ESCRITA ao CRM inteiro (removeOpportunity
# está na API). Nunca com prefixo NEXT_PUBLIC_, nunca em print ou mensagem.
# A rota FALHA FECHADO: sem qualquer uma delas, nada roda.
XMAX_BASE_URL=https://influencia40.atenderbem.com
# Chave GLOBAL (Configurações -> Geral). Usada por getAllPipelines; a chave da fila
# é rejeitada nesses endpoints com AUTH_018.
XMAX_API_KEY_GLOBAL=
# Chave da FILA do comercial. Usada com queueId em todo o resto do CRM.
XMAX_API_KEY_FILA=
# ID da fila do comercial (informado pela agência).
XMAX_QUEUE_ID=7
# Segredo que a automação do Xmax envia (cabeçalho ou campo fixo no corpo) para o
# nosso endpoint de webhook provar que o POST veio dela. Ainda não há endpoint.
XMAX_WEBHOOK_SECRET=

# ===== MÓDULO DE IA (opcional, premium) — DESLIGADO por padrão =====
# Sem ANTHROPIC_API_KEY a rota /api/ia não chama a Claude (custo zero).
ANTHROPIC_API_KEY=
# Liga a interface do chat no painel. Só aparece com o valor exato "true".
NEXT_PUBLIC_IA_ATIVA=false
# Quem pode USAR a IA — e-mails separados por vírgula (servidor, NÃO é público).
# O contexto da IA inclui gasto, conversas e CPL de TODOS os gestores, então quem
# tem acesso a ela tem acesso aos números do bônus. Enquanto as rotas não checam
# PAPEL (só se o usuário está logado), esta lista é a única trava dessa porta.
# FALHA FECHADO: vazia ou ausente = NINGUÉM usa a IA, nem o admin.
# TEMPORÁRIA: sai quando o sistema de papéis entrar.
IA_EMAILS_PERMITIDOS=igorvmeira@gmail.com

# ===== FILA DE CONTAS NOVAS (/fila-contas) — quem pode CADASTRAR conta =====
# Mesma trava temporária da IA, pelo mesmo motivo: as rotas só checam se o usuário
# está logado, não o PAPEL dele. Cadastrar uma conta muda o que TODAS as outras
# telas medem (totais, ranking de gestor, CPL da carteira) — é a escrita mais
# pesada do painel, e ela não pode ficar aberta aos 8 gestores.
# FALHA FECHADO: vazia ou ausente = ninguém abre a tela.
# TEMPORÁRIA: sai quando o sistema de papéis entrar.
FILA_EMAILS_PERMITIDOS=igorvmeira@gmail.com
